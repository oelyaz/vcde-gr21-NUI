   "source": [
    "---\n",
    "title: \"T-Rex Game\"\n",
    "author: \"Elias Seidl\"\n",
    "format:\n",
    "  html:\n",
    "    theme: cosmo\n",
    "jupyter: python3\n",
    "bibliography: references.bib\n",
    "---\n",
    "\n",
    "Control the dinosaur with hand gestures via your webcam:\n",
    "\n",
    "- **Open palm** ✋ — jump\n",
    "- **Closed fist** ✊ — duck (hold)\n",
    "- **Thumbs up** 👍 — restart after a crash\n",
    "\n",
    "```{=html}\n",
    "<div class=\"trex-host\">\n",
    "  <div id=\"main-frame-error\" class=\"interstitial-wrapper\">\n",
    "    <div id=\"main-content\">\n",
    "      <div class=\"icon icon-offline\" alt=\"\"></div>\n",
    "    </div>\n",
    "    <div id=\"offline-resources\">\n",
    "      <img id=\"offline-resources-1x\" src=\"trex/assets/default_100_percent/100-offline-sprite.png\">\n",
    "      <img id=\"offline-resources-2x\" src=\"trex/assets/default_200_percent/200-offline-sprite.png\">\n",
    "    </div>\n",
    "  </div>\n",
    "</div>\n",
    "\n",
    "<div class=\"nui-panel\">\n",
    "  <button id=\"nui-start\" type=\"button\">Start camera</button>\n",
    "  <div class=\"nui-feed\">\n",
    "    <video id=\"nui-video\" playsinline muted></video>\n",
    "    <div class=\"nui-overlay\">\n",
    "      <span id=\"nui-gesture\">—</span>\n",
    "      <span id=\"nui-status\">Camera off</span>\n",
    "    </div>\n",
    "  </div>\n",
    "</div>\n",
    "\n",
    "<style>\n",
    "  .trex-host {\n",
    "    position: relative;\n",
    "    width: 100%;\n",
    "    max-width: 800px;\n",
    "    height: 170px;\n",
    "    margin: 1.5rem auto 0.5rem;\n",
    "    overflow: hidden;\n",
    "  }\n",
    "  .trex-host #offline-resources,\n",
    "  .trex-host #main-content { display: none; }\n",
    "  .trex-host .runner-canvas {\n",
    "    display: block;\n",
    "    margin: 0 auto;\n",
    "    image-rendering: pixelated;\n",
    "  }\n",
    "\n",
    "  .nui-panel {\n",
    "    display: flex;\n",
    "    flex-direction: column;\n",
    "    align-items: center;\n",
    "    gap: 0.75rem;\n",
    "    margin: 0.5rem auto 2rem;\n",
    "  }\n",
    "  #nui-start {\n",
    "    padding: 0.5rem 1.25rem;\n",
    "    font-size: 0.95rem;\n",
    "    border: 1px solid #888;\n",
    "    background: #f4f4f4;\n",
    "    border-radius: 6px;\n",
    "    cursor: pointer;\n",
    "  }\n",
    "  #nui-start:hover { background: #e8e8e8; }\n",
    "  .nui-feed {\n",
    "    position: relative;\n",
    "    width: 280px;\n",
    "    height: 210px;\n",
    "    background: #111;\n",
    "    border-radius: 6px;\n",
    "    overflow: hidden;\n",
    "  }\n",
    "  #nui-video {\n",
    "    width: 100%;\n",
    "    height: 100%;\n",
    "    object-fit: cover;\n",
    "    transform: scaleX(-1);\n",
    "  }\n",
    "  .nui-overlay {\n",
    "    position: absolute;\n",
    "    inset: auto 0 0 0;\n",
    "    display: flex;\n",
    "    justify-content: space-between;\n",
    "    padding: 4px 8px;\n",
    "    background: rgba(0,0,0,0.55);\n",
    "    color: #fff;\n",
    "    font: 600 12px/1.2 monospace;\n",
    "  }\n",
    "</style>\n",
    "\n",
    "<script src=\"trex/trex-runner.js\"></script>\n",
    "\n",
    "<script type=\"module\">\n",
    "  const MP_VERSION = \"0.10.35\";\n",
    "  let GestureRecognizer, FilesetResolver;\n",
    "  try {\n",
    "    ({ GestureRecognizer, FilesetResolver } = await import(\n",
    "      `https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@${MP_VERSION}/vision_bundle.mjs`\n",
    "    ));\n",
    "  } catch (err) {\n",
    "    document.getElementById('nui-status').textContent = 'Load failed: ' + err.message;\n",
    "    console.error('MediaPipe import failed', err);\n",
    "    throw err;\n",
    "  }\n",
    "\n",
    "  const video    = document.getElementById('nui-video');\n",
    "  const startBtn = document.getElementById('nui-start');\n",
    "  const gestureEl = document.getElementById('nui-gesture');\n",
    "  const statusEl  = document.getElementById('nui-status');\n",
    "\n",
    "  const KEY = { JUMP: 32, DUCK: 40, RESTART: 13 };\n",
    "  const JUMP_COOLDOWN_MS = 280;\n",
    "\n",
    "  let recognizer = null;\n",
    "  let lastVideoTime = -1;\n",
    "  let lastGesture = 'None';\n",
    "  let duckHeld = false;\n",
    "  let lastJumpAt = 0;\n",
    "\n",
    "  // Drive the game directly via its onKeyDown/onKeyUp methods. Synthetic\n",
    "  // KeyboardEvents are unreliable because the t-rex-runner reads the\n",
    "  // deprecated e.keyCode, and Firefox shadows defineProperty overrides on\n",
    "  // KeyboardEvent instances with the prototype getter.\n",
    "  function fireKey(type, keyCode) {\n",
    "    const runner = window.Runner && window.Runner.instance_;\n",
    "    if (!runner) return;\n",
    "    const evt = { keyCode, type, target: document, preventDefault() {} };\n",
    "    if (type === 'keydown') runner.onKeyDown(evt);\n",
    "    else if (type === 'keyup') runner.onKeyUp(evt);\n",
    "  }\n",
    "  function tapKey(keyCode) {\n",
    "    fireKey('keydown', keyCode);\n",
    "    setTimeout(() => fireKey('keyup', keyCode), 60);\n",
    "  }\n",
    "  function setDuck(active) {\n",
    "    if (active && !duckHeld)       { fireKey('keydown', KEY.DUCK); duckHeld = true; }\n",
    "    else if (!active && duckHeld)  { fireKey('keyup',   KEY.DUCK); duckHeld = false; }\n",
    "  }\n",
    "  function tryJump() {\n",
    "    const now = performance.now();\n",
    "    if (now - lastJumpAt < JUMP_COOLDOWN_MS) return;\n",
    "    lastJumpAt = now;\n",
    "    tapKey(KEY.JUMP);\n",
    "  }\n",
    "\n",
    "  function handleGesture(g) {\n",
    "    gestureEl.textContent = g;\n",
    "    // Edge-triggered actions on gesture transitions\n",
    "    if (g !== lastGesture) {\n",
    "      if (g === 'Open_Palm') tryJump();\n",
    "      if (g === 'Thumb_Up')  tapKey(KEY.RESTART);\n",
    "    }\n",
    "    setDuck(g === 'Closed_Fist');\n",
    "    lastGesture = g;\n",
    "  }\n",
    "\n",
    "  function loop() {\n",
    "    if (video.readyState >= 2 && video.currentTime !== lastVideoTime) {\n",
    "      lastVideoTime = video.currentTime;\n",
    "      const res = recognizer.recognizeForVideo(video, performance.now());\n",
    "      const g = (res.gestures && res.gestures.length) ? res.gestures[0][0].categoryName : 'None';\n",
    "      handleGesture(g);\n",
    "    }\n",
    "    requestAnimationFrame(loop);\n",
    "  }\n",
    "\n",
    "  async function start() {\n",
    "    startBtn.disabled = true;\n",
    "    statusEl.textContent = 'Requesting camera…';\n",
    "    try {\n",
    "      // Camera first while the click's user-activation is still fresh — Firefox\n",
    "      // can reject getUserMedia with NotAllowedError after a long await chain.\n",
    "      const stream = await navigator.mediaDevices.getUserMedia({\n",
    "        video: { width: 320, height: 240, facingMode: 'user' },\n",
    "        audio: false\n",
    "      });\n",
    "      video.srcObject = stream;\n",
    "      await video.play();\n",
    "\n",
    "      statusEl.textContent = 'Loading model…';\n",
    "      const vision = await FilesetResolver.forVisionTasks(\n",
    "        `https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@${MP_VERSION}/wasm`\n",
    "      );\n",
    "      recognizer = await GestureRecognizer.createFromOptions(vision, {\n",
    "        baseOptions: {\n",
    "          modelAssetPath: \"https://storage.googleapis.com/mediapipe-models/gesture_recognizer/gesture_recognizer/float16/latest/gesture_recognizer.task\",\n",
    "          delegate: \"GPU\"\n",
    "        },\n",
    "        runningMode: \"VIDEO\",\n",
    "        numHands: 1\n",
    "      });\n",
    "      statusEl.textContent = 'Tracking';\n",
    "      startBtn.style.display = 'none';\n",
    "      requestAnimationFrame(loop);\n",
    "    } catch (err) {\n",
    "      console.error(err);\n",
    "      let msg = err.message || String(err);\n",
    "      if (err.name === 'NotAllowedError') {\n",
    "        msg = window.isSecureContext\n",
    "          ? 'Camera permission denied — allow it in the site settings.'\n",
    "          : 'Insecure context — open via http://localhost (e.g. `quarto preview`), not file:// or a LAN IP.';\n",
    "      } else if (err.name === 'NotFoundError') {\n",
    "        msg = 'No camera device found.';\n",
    "      }\n",
    "      statusEl.textContent = msg;\n",
    "      startBtn.disabled = false;\n",
    "    }\n",
    "  }\n",
    "\n",
    "  startBtn.addEventListener('click', start);\n",
    "</script>\n",
    "```"
   ]
  }
